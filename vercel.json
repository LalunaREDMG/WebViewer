{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**/*",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    {
      "source": "/api/webhook/drive",
      "destination": "/server.js"
    },
    {
      "source": "/api/sales/:path*",
      "destination": "/server.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/server.js"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/public/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(js)$",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        }
      ]
    },
    {
      "source": "/(.*)\\.(css)$",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/css; charset=utf-8"
        }
      ]
    }
  ],
  "env": {
    "ADMIN_USERNAME": "admin",
    "ADMIN_PASSWORD": "1234",
    "NODE_ENV": "production",
    "DOMAIN": "your-vercel-domain.vercel.app"
  },
  "dependencies": {
    "ws": "^8.x.x"
  }
} 